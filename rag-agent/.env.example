
# Application
APP_NAME=RAG Agent
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

#Database 
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/rag_agent

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False
